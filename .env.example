# Copie para .env e preencha. O .env fica fora do Git.
# A chave nasce no painel do Post for Me: https://www.postforme.dev
POSTFORME_API_KEY=

# Id da conta do Instagram no Post for Me. Começa com spc_.
# Rode "npm run kit -- conectar" e depois "npm run kit -- contas" para descobrir.
POSTFORME_ACCOUNT_ID=
